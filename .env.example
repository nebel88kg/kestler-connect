# Site URL (for sitemap, canonical URLs)
NEXT_PUBLIC_SITE_URL=https://www.kestler-connect.de

# Contact details
NEXT_PUBLIC_PHONE=+49 175 2665058
NEXT_PUBLIC_WHATSAPP=491752665058

# Email notifications (Resend)
RESEND_API_KEY=
CONTACT_EMAIL=Jascha@kestler-connect.de
CONTACT_FROM=Kestler Connect <noreply@send.kestler-connect.de>

# Automatische Bestätigungsmail an Absender des Kontaktformulars
# Optional – Standard (ohne Variable): Jascha Kestler <jascha@send.kestler-connect.de>
# (Subdomain send.kestler-connect.de ist in Resend verifiziert). Reply-To ist immer jascha@kestler-connect.de.
# Nur setzen, um den Absender zu überschreiben; die Domain muss in Resend verifiziert sein.
# CONFIRMATION_FROM=Jascha Kestler <jascha@send.kestler-connect.de>
# "false" schaltet die Bestätigungsmail ab (Standard: an)
# CONFIRMATION_EMAIL_ENABLED=true
